# ─────────────────────────────────────────────────────────────────────────────
# LudicON — Docker Compose environment
#
# Copy to `.env` at the repo root. Compose reads this file for two purposes:
#   1. interpolating ${VAR} in docker-compose.yml
#   2. injecting variables into the containers (via `env_file`)
#
# Every value below also has a default baked into docker-compose.yml, so
# `npm run docker:web` works with no `.env` at all. Create one when you need to
# change ports, point at a different database, or supply Clerk keys.
#
# ⚠ PLACEHOLDERS ONLY. Nothing in this file is a real credential, and nothing
#   real should ever be committed here — `.env` itself is gitignored and
#   excluded from every Docker build context.
# ─────────────────────────────────────────────────────────────────────────────


# ── Compose ──────────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=ludicon

# Which Dockerfile stage each service builds.
#   dev      hot reload, sources bind-mounted from the host
#   runtime  production-like image (nginx for web, non-root node for api/worker)
WEB_TARGET=dev
API_TARGET=dev
WORKER_TARGET=dev

# Host-side ports. Change these if something already owns them locally.
WEB_PORT=5173
API_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379


# ── Shared ───────────────────────────────────────────────────────────────────

NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info


# ── PostgreSQL ───────────────────────────────────────────────────────────────
# If you change POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB you must update
# DATABASE_URL to match — they are not derived from each other.

POSTGRES_USER=ludicon
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ludicon

# Host is the compose service name, reachable from other containers.
DATABASE_URL=postgresql://ludicon:change-me-local-only@postgres:5432/ludicon


# ── Redis / queue ────────────────────────────────────────────────────────────

REDIS_URL=redis://redis:6379

# Namespace for BullMQ keys. The API (producer) and the worker (consumer) must
# agree on this or they will silently use different queues. `bull` is BullMQ's
# own default — change both sides together or leave it alone.
QUEUE_PREFIX=bull


# ── API ──────────────────────────────────────────────────────────────────────

PORT=3000

# Origin allowed to call the API from a browser. Match WEB_PORT.
CORS_ORIGIN=http://localhost:5173


# ── Clerk (authentication) ───────────────────────────────────────────────────
# Get real values from the Clerk dashboard. Leave the placeholders in place to
# run without authentication wired up.
#
# The publishable key is inlined into the browser bundle at build time and is
# not secret. The secret key is server-side only and must never be given a
# VITE_ prefix.

CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
VITE_CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key


# ── Web (build-time) ─────────────────────────────────────────────────────────
# VITE_-prefixed values are baked into the bundle when the `runtime` target is
# built, so they are readable by anyone who loads the page. Never put a secret
# behind a VITE_ prefix.

VITE_API_URL=http://localhost:3000


# ── Worker ───────────────────────────────────────────────────────────────────
# See apps/worker/.env.example for the full set and their meanings.

WORKER_CONCURRENCY=4
WORKER_JOB_ATTEMPTS=3

# Must stay below the worker's `stop_grace_period` in docker-compose.yml.
WORKER_SHUTDOWN_TIMEOUT_MS=25000
