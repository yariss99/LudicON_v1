{
  "id": "summarize-resource",
  "kind": "summarize-resource",
  "displayName": "Summarize Resource",
  "version": "1.0.0",
  "purpose": "Produce a teacher-facing summary of a resource for planning or review.",
  "entryConditions": [
    "Source resourceId exists"
  ],
  "requiredContext": [
    {
      "key": "teacher.teacherId",
      "required": true,
      "description": "Teacher identity"
    },
    {
      "key": "resourceId",
      "required": true,
      "description": "Source resource"
    },
    {
      "key": "projectId",
      "required": true,
      "description": "Project"
    }
  ],
  "requiredPermissions": [
    "workflow:start",
    "workflow:generate",
    "workflow:review",
    "resource:read"
  ],
  "initialState": "Idle",
  "allowedStates": [
    "Idle",
    "Initializing",
    "LoadingContext",
    "Planning",
    "Generating",
    "Validating",
    "Editing",
    "Reviewing",
    "Ready",
    "Publishing",
    "Completed",
    "Failed",
    "Cancelled"
  ],
  "allowedEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationFailed",
    "Edit",
    "SaveDraft",
    "Publish",
    "Retry",
    "Cancel",
    "Restore",
    "Complete"
  ],
  "happyPathEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationPassed",
    "Complete"
  ],
  "phases": [
    {
      "phaseId": "start",
      "title": "Start",
      "description": "Open Summary workflow.",
      "engineState": "Initializing",
      "enterEvent": "CreateWorkflow",
      "requiredContextKeys": [
        "teacher.teacherId"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "load-context",
      "title": "Load Context",
      "description": "Load project, subject, grade, and source references.",
      "engineState": "LoadingContext",
      "enterEvent": "LoadContext",
      "requiredContextKeys": [
        "projectId"
      ],
      "actor": "either"
    },
    {
      "phaseId": "plan",
      "title": "Plan",
      "description": "Confirm summary length and audience (teacher).",
      "engineState": "Planning",
      "enterEvent": "PlanningCompleted",
      "requiredContextKeys": [
        "temporaryMemory.plan"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "generate",
      "title": "Generate Summary",
      "description": "AI Orchestrator produces a draft; teacher remains author.",
      "engineState": "Generating",
      "enterEvent": "Generate",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "validate",
      "title": "Validate",
      "description": "Validate schema and educational integrity.",
      "engineState": "Validating",
      "enterEvent": "GenerationCompleted",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "review",
      "title": "Teacher Review",
      "description": "Teacher reviews and may edit or regenerate.",
      "engineState": "Reviewing",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    },
    {
      "phaseId": "ready-publish",
      "title": "Ready / Publish",
      "description": "Confirm readiness and optionally publish.",
      "engineState": "Ready",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    }
  ],
  "validationRules": [
    {
      "ruleId": "SR-V1",
      "description": "Summary must remain pedagogically faithful",
      "appliesAt": "Validating",
      "severity": "warn"
    }
  ],
  "failureStates": [
    "Failed",
    "Cancelled"
  ],
  "recovery": {
    "onFailed": "Retry→Planning",
    "onCancelled": "Restore",
    "onValidationFailed": "Edit",
    "notes": "Failed → Retry returns to Planning; ValidationFailed → Editing; Cancelled → Restore from history or start a new session. AI never dispatches."
  },
  "completionCriteria": [
    "State Completed",
    "Summary artifact stored"
  ],
  "producedObjects": [
    "Summary",
    "DraftResource"
  ],
  "aiRequestTypes": [
    "Summarize"
  ],
  "tags": [
    "summarize",
    "resource"
  ]
}