{
  "id": "create-assessment",
  "kind": "create-assessment",
  "displayName": "Create Assessment",
  "version": "1.0.0",
  "purpose": "Design a formative or summative assessment with valid evidence of learning.",
  "entryConditions": [
    "Teacher authenticated",
    "Project writable"
  ],
  "requiredContext": [
    {
      "key": "teacher.teacherId",
      "required": true,
      "description": "Authenticated teacher identity"
    },
    {
      "key": "projectId",
      "required": true,
      "description": "Target project for the resource"
    },
    {
      "key": "temporaryMemory.subject",
      "required": true,
      "description": "Subject selected during LoadingContext / Planning"
    },
    {
      "key": "temporaryMemory.grade",
      "required": true,
      "description": "Grade band"
    },
    {
      "key": "temporaryMemory.assessmentType",
      "required": true,
      "description": "formative | summative | diagnostic-light (non-clinical)"
    }
  ],
  "requiredPermissions": [
    "workflow:start",
    "workflow:generate",
    "workflow:review",
    "workflow:publish",
    "project:write"
  ],
  "initialState": "Idle",
  "allowedStates": [
    "Idle",
    "Initializing",
    "LoadingContext",
    "Planning",
    "Generating",
    "Validating",
    "Editing",
    "Reviewing",
    "Ready",
    "Publishing",
    "Completed",
    "Failed",
    "Cancelled"
  ],
  "allowedEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationFailed",
    "Edit",
    "SaveDraft",
    "Publish",
    "Retry",
    "Cancel",
    "Restore",
    "Complete"
  ],
  "happyPathEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationPassed",
    "Publish",
    "Complete"
  ],
  "phases": [
    {
      "phaseId": "start",
      "title": "Start",
      "description": "Open Assessment workflow.",
      "engineState": "Initializing",
      "enterEvent": "CreateWorkflow",
      "requiredContextKeys": [
        "teacher.teacherId"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "load-context",
      "title": "Load Context",
      "description": "Load project, subject, grade, and source references.",
      "engineState": "LoadingContext",
      "enterEvent": "LoadContext",
      "requiredContextKeys": [
        "projectId"
      ],
      "actor": "either"
    },
    {
      "phaseId": "plan",
      "title": "Plan",
      "description": "Define assessment purpose, criteria, and evidence types.",
      "engineState": "Planning",
      "enterEvent": "PlanningCompleted",
      "requiredContextKeys": [
        "temporaryMemory.plan"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "generate",
      "title": "Generate Assessment",
      "description": "AI Orchestrator produces a draft; teacher remains author.",
      "engineState": "Generating",
      "enterEvent": "Generate",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "validate",
      "title": "Validate",
      "description": "Validate schema and educational integrity.",
      "engineState": "Validating",
      "enterEvent": "GenerationCompleted",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "review",
      "title": "Teacher Review",
      "description": "Teacher reviews and may edit or regenerate.",
      "engineState": "Reviewing",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    },
    {
      "phaseId": "ready-publish",
      "title": "Ready / Publish",
      "description": "Confirm readiness and optionally publish.",
      "engineState": "Ready",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    }
  ],
  "validationRules": [
    {
      "ruleId": "CA-V1",
      "description": "Assessment must not diagnose or label learners",
      "appliesAt": "Validating",
      "severity": "block"
    },
    {
      "ruleId": "CA-V2",
      "description": "Criteria of quality must be present before Ready",
      "appliesAt": "Reviewing",
      "severity": "block"
    }
  ],
  "failureStates": [
    "Failed",
    "Cancelled"
  ],
  "recovery": {
    "onFailed": "Retry→Planning",
    "onCancelled": "Restore",
    "onValidationFailed": "Edit",
    "notes": "Failed → Retry returns to Planning; ValidationFailed → Editing; Cancelled → Restore from history or start a new session. AI never dispatches."
  },
  "completionCriteria": [
    "State Completed",
    "Assessment artifact persisted"
  ],
  "producedObjects": [
    "Assessment",
    "DraftResource",
    "PublishedResource"
  ],
  "aiRequestTypes": [
    "GenerateQuiz"
  ],
  "tags": [
    "create",
    "assessment"
  ]
}