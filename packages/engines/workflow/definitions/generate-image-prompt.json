{
  "id": "generate-image-prompt",
  "kind": "generate-image-prompt",
  "displayName": "Generate Image Prompt",
  "version": "1.0.0",
  "purpose": "Produce a safe, educational image prompt for classroom visuals — not the image itself.",
  "entryConditions": [
    "Teacher authenticated",
    "Source resource or topic available"
  ],
  "requiredContext": [
    {
      "key": "teacher.teacherId",
      "required": true,
      "description": "Teacher identity"
    },
    {
      "key": "projectId",
      "required": true,
      "description": "Project"
    },
    {
      "key": "temporaryMemory.visualIntent",
      "required": true,
      "description": "What the image should support pedagogically"
    }
  ],
  "requiredPermissions": [
    "workflow:start",
    "workflow:generate",
    "workflow:review"
  ],
  "initialState": "Idle",
  "allowedStates": [
    "Idle",
    "Initializing",
    "LoadingContext",
    "Planning",
    "Generating",
    "Validating",
    "Editing",
    "Reviewing",
    "Ready",
    "Publishing",
    "Completed",
    "Failed",
    "Cancelled"
  ],
  "allowedEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationFailed",
    "Edit",
    "SaveDraft",
    "Publish",
    "Retry",
    "Cancel",
    "Restore",
    "Complete"
  ],
  "happyPathEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationPassed",
    "Complete"
  ],
  "phases": [
    {
      "phaseId": "start",
      "title": "Start",
      "description": "Open Image Prompt workflow.",
      "engineState": "Initializing",
      "enterEvent": "CreateWorkflow",
      "requiredContextKeys": [
        "teacher.teacherId"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "load-context",
      "title": "Load Context",
      "description": "Load project, subject, grade, and source references.",
      "engineState": "LoadingContext",
      "enterEvent": "LoadContext",
      "requiredContextKeys": [
        "projectId"
      ],
      "actor": "either"
    },
    {
      "phaseId": "plan",
      "title": "Plan",
      "description": "Define visual intent, inclusion constraints, and style limits.",
      "engineState": "Planning",
      "enterEvent": "PlanningCompleted",
      "requiredContextKeys": [
        "temporaryMemory.plan"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "generate",
      "title": "Generate Image Prompt",
      "description": "AI Orchestrator produces a draft; teacher remains author.",
      "engineState": "Generating",
      "enterEvent": "Generate",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "validate",
      "title": "Validate",
      "description": "Validate schema and educational integrity.",
      "engineState": "Validating",
      "enterEvent": "GenerationCompleted",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "review",
      "title": "Teacher Review",
      "description": "Teacher reviews and may edit or regenerate.",
      "engineState": "Reviewing",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    },
    {
      "phaseId": "ready-publish",
      "title": "Ready / Publish",
      "description": "Confirm readiness and optionally publish.",
      "engineState": "Ready",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    }
  ],
  "validationRules": [
    {
      "ruleId": "GIP-V1",
      "description": "Unsafe or non-educational imagery intents are blocked",
      "appliesAt": "Validating",
      "severity": "block"
    }
  ],
  "failureStates": [
    "Failed",
    "Cancelled"
  ],
  "recovery": {
    "onFailed": "Retry→Planning",
    "onCancelled": "Restore",
    "onValidationFailed": "Edit",
    "notes": "Failed → Retry returns to Planning; ValidationFailed → Editing; Cancelled → Restore from history or start a new session. AI never dispatches."
  },
  "completionCriteria": [
    "State Completed",
    "Image prompt text stored on resource"
  ],
  "producedObjects": [
    "ImagePrompt",
    "DraftResource"
  ],
  "aiRequestTypes": [
    "GenerateImagePrompt"
  ],
  "tags": [
    "generate",
    "media"
  ]
}