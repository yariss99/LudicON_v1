{
  "id": "create-lesson",
  "kind": "create-lesson",
  "displayName": "Create Lesson",
  "version": "1.0.0",
  "purpose": "Guide a teacher from subject/grade through curriculum-aligned lesson design to a reviewed, publishable lesson.",
  "entryConditions": [
    "Teacher is authenticated",
    "Teacher may create resources in the target project",
    "No conflicting open create-lesson session for the same lessonId (optional)"
  ],
  "requiredContext": [
    {
      "key": "teacher.teacherId",
      "required": true,
      "description": "Authenticated teacher identity"
    },
    {
      "key": "projectId",
      "required": true,
      "description": "Target project for the resource"
    },
    {
      "key": "temporaryMemory.subject",
      "required": true,
      "description": "Subject selected during LoadingContext / Planning"
    },
    {
      "key": "temporaryMemory.grade",
      "required": true,
      "description": "Grade band"
    },
    {
      "key": "temporaryMemory.curriculumRef",
      "required": true,
      "description": "Curriculum pack reference"
    },
    {
      "key": "temporaryMemory.competencies",
      "required": true,
      "description": "Selected competencies"
    },
    {
      "key": "temporaryMemory.objectives",
      "required": true,
      "description": "Learning objectives"
    }
  ],
  "requiredPermissions": [
    "workflow:start",
    "workflow:edit",
    "workflow:generate",
    "workflow:review",
    "workflow:publish",
    "project:write",
    "curriculum:read"
  ],
  "initialState": "Idle",
  "allowedStates": [
    "Idle",
    "Initializing",
    "LoadingContext",
    "Planning",
    "Generating",
    "Validating",
    "Editing",
    "Reviewing",
    "Ready",
    "Publishing",
    "Completed",
    "Failed",
    "Cancelled"
  ],
  "allowedEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationFailed",
    "Edit",
    "SaveDraft",
    "Publish",
    "Retry",
    "Cancel",
    "Restore",
    "Complete"
  ],
  "happyPathEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationPassed",
    "Publish",
    "Complete"
  ],
  "phases": [
    {
      "phaseId": "start",
      "title": "Start",
      "description": "Open a new lesson workflow session.",
      "engineState": "Initializing",
      "enterEvent": "CreateWorkflow",
      "requiredContextKeys": [
        "teacher.teacherId"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "select-subject",
      "title": "Select Subject",
      "description": "Teacher declares subject for the lesson.",
      "engineState": "LoadingContext",
      "enterEvent": "LoadContext",
      "requiredContextKeys": [
        "temporaryMemory.subject"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "select-grade",
      "title": "Select Grade",
      "description": "Teacher declares grade band.",
      "engineState": "LoadingContext",
      "requiredContextKeys": [
        "temporaryMemory.grade"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "load-curriculum",
      "title": "Load Curriculum",
      "description": "System loads curriculum pack for subject and grade.",
      "engineState": "LoadingContext",
      "requiredContextKeys": [
        "temporaryMemory.curriculumRef"
      ],
      "actor": "system"
    },
    {
      "phaseId": "define-competencies",
      "title": "Define Competencies",
      "description": "Teacher confirms competencies (AI may propose).",
      "engineState": "Planning",
      "enterEvent": "PlanningCompleted",
      "requiredContextKeys": [
        "temporaryMemory.competencies"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "define-objectives",
      "title": "Define Objectives",
      "description": "Teacher confirms learning objectives.",
      "engineState": "Planning",
      "requiredContextKeys": [
        "temporaryMemory.objectives"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "choose-strategy",
      "title": "Choose Teaching Strategy",
      "description": "Teacher selects instructional strategy.",
      "engineState": "Planning",
      "requiredContextKeys": [
        "temporaryMemory.teachingStrategy"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "generate-lesson",
      "title": "Generate Lesson",
      "description": "AI Orchestrator generates a draft lesson under teacher authority.",
      "engineState": "Generating",
      "enterEvent": "Generate",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "validate",
      "title": "Validate",
      "description": "Structural and pedagogical validation of the draft.",
      "engineState": "Validating",
      "enterEvent": "GenerationCompleted",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "teacher-review",
      "title": "Teacher Review",
      "description": "Teacher reviews, edits, or requests regeneration.",
      "engineState": "Reviewing",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    },
    {
      "phaseId": "save-draft",
      "title": "Save Draft",
      "description": "Persist draft without publishing (Editing + SaveDraft).",
      "engineState": "Editing",
      "enterEvent": "Edit",
      "requiredContextKeys": [
        "resourceId"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "ready",
      "title": "Ready",
      "description": "Teacher confirms the lesson is ready.",
      "engineState": "Ready",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    },
    {
      "phaseId": "publish",
      "title": "Publish",
      "description": "Publish the approved lesson resource.",
      "engineState": "Publishing",
      "enterEvent": "Publish",
      "requiredContextKeys": [
        "resourceId"
      ],
      "actor": "teacher"
    }
  ],
  "validationRules": [
    {
      "ruleId": "CL-V1",
      "description": "Subject and grade must be set before PlanningCompleted",
      "appliesAt": "LoadingContext",
      "severity": "block"
    },
    {
      "ruleId": "CL-V2",
      "description": "Competencies and objectives required before Generate",
      "appliesAt": "Planning",
      "severity": "block"
    },
    {
      "ruleId": "CL-V3",
      "description": "Teacher ValidationPassed required before Ready",
      "appliesAt": "Reviewing",
      "severity": "block"
    },
    {
      "ruleId": "CL-V4",
      "description": "No learner labeling or diagnostic language in outputs",
      "appliesAt": "Validating",
      "severity": "block"
    }
  ],
  "failureStates": [
    "Failed",
    "Cancelled"
  ],
  "recovery": {
    "onFailed": "Retry→Planning",
    "onCancelled": "Restore",
    "onValidationFailed": "Edit",
    "notes": "Failed → Retry returns to Planning; ValidationFailed → Editing; Cancelled → Restore from history or start a new session. AI never dispatches."
  },
  "completionCriteria": [
    "Engine state is Completed",
    "Lesson resourceId persisted",
    "Teacher confirmed review (ValidationPassed → Ready or Publish path)"
  ],
  "producedObjects": [
    "Lesson",
    "DraftResource",
    "PublishedResource"
  ],
  "aiRequestTypes": [
    "GenerateLesson",
    "ImproveLesson"
  ],
  "tags": [
    "create",
    "lesson",
    "core"
  ]
}