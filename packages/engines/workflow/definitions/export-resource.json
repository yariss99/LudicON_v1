{
  "id": "export-resource",
  "kind": "export-resource",
  "displayName": "Export Resource",
  "version": "1.0.0",
  "purpose": "Export a resource package for classroom use or archival.",
  "entryConditions": [
    "resourceId exists",
    "Teacher may export"
  ],
  "requiredContext": [
    {
      "key": "teacher.teacherId",
      "required": true,
      "description": "Teacher identity"
    },
    {
      "key": "resourceId",
      "required": true,
      "description": "Resource to export"
    },
    {
      "key": "projectId",
      "required": true,
      "description": "Project"
    },
    {
      "key": "temporaryMemory.exportFormat",
      "required": true,
      "description": "Export format identifier"
    }
  ],
  "requiredPermissions": [
    "workflow:start",
    "workflow:export",
    "resource:read"
  ],
  "initialState": "Idle",
  "allowedStates": [
    "Idle",
    "Initializing",
    "LoadingContext",
    "Planning",
    "Generating",
    "Validating",
    "Editing",
    "Reviewing",
    "Ready",
    "Publishing",
    "Completed",
    "Failed",
    "Cancelled"
  ],
  "allowedEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationFailed",
    "Edit",
    "SaveDraft",
    "Publish",
    "Retry",
    "Cancel",
    "Restore",
    "Complete"
  ],
  "happyPathEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationPassed",
    "Complete"
  ],
  "phases": [
    {
      "phaseId": "start",
      "title": "Start",
      "description": "Open Export Package workflow.",
      "engineState": "Initializing",
      "enterEvent": "CreateWorkflow",
      "requiredContextKeys": [
        "teacher.teacherId"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "load-context",
      "title": "Load Context",
      "description": "Load project, subject, grade, and source references.",
      "engineState": "LoadingContext",
      "enterEvent": "LoadContext",
      "requiredContextKeys": [
        "projectId"
      ],
      "actor": "either"
    },
    {
      "phaseId": "plan",
      "title": "Plan",
      "description": "Choose export format and included assets.",
      "engineState": "Planning",
      "enterEvent": "PlanningCompleted",
      "requiredContextKeys": [
        "temporaryMemory.plan"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "generate",
      "title": "Generate Export Package",
      "description": "AI Orchestrator produces a draft; teacher remains author.",
      "engineState": "Generating",
      "enterEvent": "Generate",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "validate",
      "title": "Validate",
      "description": "Validate schema and educational integrity.",
      "engineState": "Validating",
      "enterEvent": "GenerationCompleted",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "review",
      "title": "Teacher Review",
      "description": "Teacher reviews and may edit or regenerate.",
      "engineState": "Reviewing",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    },
    {
      "phaseId": "ready-publish",
      "title": "Ready / Publish",
      "description": "Confirm readiness and optionally publish.",
      "engineState": "Ready",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    }
  ],
  "validationRules": [
    {
      "ruleId": "ER-V1",
      "description": "Export format must be supported",
      "appliesAt": "Planning",
      "severity": "block"
    }
  ],
  "failureStates": [
    "Failed",
    "Cancelled"
  ],
  "recovery": {
    "onFailed": "Retry→Planning",
    "onCancelled": "Restore",
    "onValidationFailed": "Edit",
    "notes": "Failed → Retry returns to Planning; ValidationFailed → Editing; Cancelled → Restore from history or start a new session. AI never dispatches."
  },
  "completionCriteria": [
    "State Completed",
    "ExportPackage artifact available"
  ],
  "producedObjects": [
    "ExportPackage"
  ],
  "tags": [
    "export",
    "resource"
  ]
}