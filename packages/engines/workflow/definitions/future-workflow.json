{
  "id": "future-workflow",
  "kind": "future-workflow",
  "displayName": "Future Workflows",
  "version": "0.0.0",
  "purpose": "Extension point: register new CatalogWorkflow entries with new kinds; do not fork the Workflow Engine.",
  "entryConditions": [
    "Not executable — template only"
  ],
  "requiredContext": [],
  "requiredPermissions": [
    "workflow:start"
  ],
  "initialState": "Idle",
  "allowedStates": [
    "Idle",
    "Initializing",
    "LoadingContext",
    "Planning",
    "Generating",
    "Validating",
    "Editing",
    "Reviewing",
    "Ready",
    "Publishing",
    "Completed",
    "Failed",
    "Cancelled"
  ],
  "allowedEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationFailed",
    "Edit",
    "SaveDraft",
    "Publish",
    "Retry",
    "Cancel",
    "Restore",
    "Complete"
  ],
  "happyPathEvents": [
    "CreateWorkflow",
    "LoadContext",
    "PlanningCompleted",
    "Generate",
    "GenerationCompleted",
    "ValidationPassed",
    "ValidationPassed",
    "Publish",
    "Complete"
  ],
  "phases": [
    {
      "phaseId": "start",
      "title": "Start",
      "description": "Open Future Resource workflow.",
      "engineState": "Initializing",
      "enterEvent": "CreateWorkflow",
      "requiredContextKeys": [
        "teacher.teacherId"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "load-context",
      "title": "Load Context",
      "description": "Load project, subject, grade, and source references.",
      "engineState": "LoadingContext",
      "enterEvent": "LoadContext",
      "requiredContextKeys": [
        "projectId"
      ],
      "actor": "either"
    },
    {
      "phaseId": "plan",
      "title": "Plan",
      "description": "Replace with concrete planning notes when specifying a new workflow.",
      "engineState": "Planning",
      "enterEvent": "PlanningCompleted",
      "requiredContextKeys": [
        "temporaryMemory.plan"
      ],
      "actor": "teacher"
    },
    {
      "phaseId": "generate",
      "title": "Generate Future Resource",
      "description": "AI Orchestrator produces a draft; teacher remains author.",
      "engineState": "Generating",
      "enterEvent": "Generate",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "validate",
      "title": "Validate",
      "description": "Validate schema and educational integrity.",
      "engineState": "Validating",
      "enterEvent": "GenerationCompleted",
      "requiredContextKeys": [],
      "actor": "system"
    },
    {
      "phaseId": "review",
      "title": "Teacher Review",
      "description": "Teacher reviews and may edit or regenerate.",
      "engineState": "Reviewing",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    },
    {
      "phaseId": "ready-publish",
      "title": "Ready / Publish",
      "description": "Confirm readiness and optionally publish.",
      "engineState": "Ready",
      "enterEvent": "ValidationPassed",
      "requiredContextKeys": [],
      "actor": "teacher"
    }
  ],
  "validationRules": [],
  "failureStates": [
    "Failed",
    "Cancelled"
  ],
  "recovery": {
    "onFailed": "Retry→Planning",
    "onCancelled": "Restore",
    "onValidationFailed": "Edit",
    "notes": "Failed → Retry returns to Planning; ValidationFailed → Editing; Cancelled → Restore from history or start a new session. AI never dispatches."
  },
  "completionCriteria": [
    "Defined by future product specification"
  ],
  "producedObjects": [
    "DraftResource"
  ],
  "tags": [
    "future",
    "template"
  ]
}