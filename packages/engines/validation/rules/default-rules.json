[
  {
    "ruleId": "SCHEMA-REQUIRED-TITLE",
    "description": "Artifacts must have a title",
    "validatorId": "schema",
    "artifactTypes": ["Lesson", "Worksheet", "Quiz", "Presentation", "Story", "Assessment"],
    "profiles": ["Draft", "InternalReview", "Publication", "Export", "AIDebug"],
    "severity": "CRITICAL",
    "enabled": true,
    "when": { "op": "empty", "path": "title" },
    "message": "Missing required field: title.",
    "recommendation": "Add a clear educational title.",
    "repairPossible": true
  },
  {
    "ruleId": "READABILITY-GRADE2",
    "description": "IF lesson.grade = 2 AND worksheet.readability > Grade2Limit THEN WARNING",
    "validatorId": "language",
    "artifactTypes": ["Worksheet", "Story", "Lesson"],
    "profiles": ["InternalReview", "Publication", "AIDebug"],
    "severity": "WARNING",
    "enabled": true,
    "when": {
      "op": "and",
      "conditions": [
        { "op": "eq", "path": "grade", "value": "2" },
        { "op": "gt", "path": "readability", "value": 3 }
      ]
    },
    "message": "Readability appears above Grade 2 limit.",
    "recommendation": "Simplify vocabulary for Grade 2 learners.",
    "repairPossible": false
  }
]
