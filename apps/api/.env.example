##############################################################################
# @ludicon/api — environment
#
# Copy to `.env` and fill in. The process validates every variable at startup
# (src/env.ts) and refuses to boot on a bad value, so a typo here fails loudly
# in the first second rather than on a request an hour later.
#
# Variables without a default are REQUIRED.
##############################################################################

# --- Runtime ----------------------------------------------------------------

# development | test | production
# Also decides the default for VALIDATE_RESPONSES below.
NODE_ENV=development


# --- HTTP -------------------------------------------------------------------

# Port the HTTP server binds to.                        default: 8787
PORT=8787

# Interface to bind. 0.0.0.0 inside a container, 127.0.0.1 on a laptop.
#                                                       default: 0.0.0.0
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call this API.
# EMPTY MEANS SAME-ORIGIN ONLY — never set this to "*". This API serves a
# teacher's own materials.                              default: (empty)
CORS_ORIGINS=http://localhost:5173

# Seconds a browser may cache the CORS preflight.       default: 600
CORS_MAX_AGE_SECONDS=600


# --- Database (PostgreSQL) --------------------------------------------------

# REQUIRED. Must start with postgres:// or postgresql://
DATABASE_URL=postgresql://ludicon:ludicon@localhost:5432/ludicon

# Maximum pooled connections held by this process.
# Size it against your Postgres max_connections divided by the number of API
# instances, not against expected traffic.              default: 10
DATABASE_POOL_MAX=10

# Connect over TLS. Managed Postgres normally requires this; local Docker does
# not. Accepts true/false/1/0/yes/no.                   default: false
DATABASE_SSL=false

# Milliseconds a request waits for a free connection before failing.
#                                                       default: 10000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Folder holding generated SQL migrations, used by the programmatic runner
# (src/db/migrate.ts).                                  default: ./drizzle
DATABASE_MIGRATIONS_DIR=./drizzle


# --- Queue (Redis / BullMQ) -------------------------------------------------

# REQUIRED. Must start with redis:// or rediss://
REDIS_URL=redis://localhost:6379

# How many times a failed job is retried before it is parked.
#                                                       default: 3
QUEUE_JOB_ATTEMPTS=3

# Base delay for the exponential retry backoff, in milliseconds.
#                                                       default: 5000
QUEUE_JOB_BACKOFF_MS=5000


# --- Authentication (Clerk) -------------------------------------------------

# REQUIRED. Server-side secret. Never ships to the browser, never gets logged.
CLERK_SECRET_KEY=sk_test_replace_me

# REQUIRED. Public key; safe to expose, kept here so the API and the web app
# are configured from one place.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# OPTIONAL. PEM public key for networkless token verification. Without it the
# API fetches (and caches) Clerk's JWKS instead, costing a round trip on cold
# start.                                                default: (unset)
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Comma-separated origins accepted in the token's `azp` claim. Leaving this
# empty DISABLES the check — set it in production.      default: (empty)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173


# --- Observability ----------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent  default: info
LOG_LEVEL=info

# Human-readable single-line logs for a terminal. Production emits NDJSON, so
# leave this false there. Requires the pino-pretty devDependency.
#                                                       default: false
LOG_PRETTY=true


# --- Behaviour --------------------------------------------------------------

# Parse every outgoing body against its contract before sending it. Catches
# drift between a handler and @ludicon/contracts at the point of the mistake.
#                       default: true outside production, false in production
# VALIDATE_RESPONSES=true

# Milliseconds allowed for an in-flight request to finish on SIGTERM before the
# process exits anyway. Keep it below your orchestrator's grace period.
#                                                       default: 15000
SHUTDOWN_TIMEOUT_MS=15000
