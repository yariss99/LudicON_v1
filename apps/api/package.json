{
  "name": "@ludicon/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "clean": "rm -rf dist .turbo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/backend": "3.16.0",
    "@hono/node-server": "2.1.0",
    "@hono/zod-validator": "0.9.0",
    "@ludicon/contracts": "*",
    "@ludicon/domain": "*",
    "@ludicon/evaluation": "*",
    "bullmq": "6.0.9",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pino": "10.3.1",
    "tsx": "^4.23.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ludicon/config": "*",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "0.31.10",
    "oxlint": "^1.71.0",
    "pino-pretty": "^13.1.3",
    "typescript": "~6.0.3"
  }
}
