# ─────────────────────────────────────────────────────────────────────────────
# @ludicon/worker — environment
#
# Every variable the worker reads is listed here. Values shown are the built-in
# defaults; only REDIS_URL is required. The process refuses to start if any
# value fails validation (see src/env.ts).
#
# Copy to `apps/worker/.env` for local runs outside Docker. Under Docker Compose
# these come from the repo-root `.env` instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development

# Identifies this process in every log line and in Redis `CLIENT LIST`.
SERVICE_NAME=ludicon-worker

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info


# ── Redis / queue ────────────────────────────────────────────────────────────

# REQUIRED. Must be a redis:// or rediss:// URL.
# Docker Compose: redis://redis:6379
# Local:          redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# Namespace for all BullMQ keys. The API (producer) and this worker MUST use
# the same value or they will silently operate on different queues.
# `bull` is BullMQ's own default — change both sides together or not at all.
QUEUE_PREFIX=bull


# ── Throughput ───────────────────────────────────────────────────────────────

# Jobs processed in parallel, per queue, per worker process. 1-100.
WORKER_CONCURRENCY=4


# ── Retries and backoff ──────────────────────────────────────────────────────
# `attempts` and `backoff` are stamped on a job when it is *enqueued*, so the
# API must apply the same policy (it can import `buildJobOptions` from this
# app's `lib/job-policy.ts`). The worker additionally enforces
# WORKER_JOB_ATTEMPTS as a hard ceiling on how many times a job may start,
# which caps poison messages regardless of what the producer asked for.

# Total attempts including the first. 1-20.
WORKER_JOB_ATTEMPTS=3

# Base delay for exponential backoff: delay * 2^(attempt - 1), in ms.
WORKER_BACKOFF_DELAY_MS=2000

# Backoff jitter as a fraction of the computed delay (0 = none, 1 = full).
# Non-zero stops jobs that failed together from retrying in lockstep.
WORKER_BACKOFF_JITTER=0.3


# ── Locks and stall recovery ─────────────────────────────────────────────────

# How long a job's lock is held before the stalled checker may reclaim it.
# Must exceed the longest plausible single job execution, in ms.
WORKER_LOCK_DURATION_MS=60000

# How many times a stalled job may be recovered before it is failed outright.
WORKER_MAX_STALLED_COUNT=2


# ── Shutdown ─────────────────────────────────────────────────────────────────

# On SIGTERM/SIGINT the worker stops fetching and waits this long for in-flight
# jobs. Keep it below the orchestrator's kill timeout (Compose
# `stop_grace_period`, Kubernetes `terminationGracePeriodSeconds`) so the
# process controls its own exit. Jobs still running when it elapses are
# abandoned and recovered by the stalled checker.
WORKER_SHUTDOWN_TIMEOUT_MS=25000


# ── Retention ────────────────────────────────────────────────────────────────
# Applied on a best-effort basis by BullMQ when a job finishes.

# Completed jobs: kept up to this age (seconds) and this count.
KEEP_COMPLETED_AGE_S=86400
KEEP_COMPLETED_COUNT=1000

# Failed jobs: kept longer — the `failed` set is the incident record.
KEEP_FAILED_AGE_S=604800
KEEP_FAILED_COUNT=5000


# ── Dead letter ──────────────────────────────────────────────────────────────
# Permanently failed jobs (attempts exhausted, or an UnrecoverableError) are
# copied to `<queue>:<suffix>`. Nothing consumes that queue, so entries survive
# the retention policy above until an operator drains them.

# true | false | 1 | 0
DEAD_LETTER_ENABLED=true
DEAD_LETTER_SUFFIX=dead-letter


# ── Stubs ────────────────────────────────────────────────────────────────────
# The handlers have no real backend yet. This is how long they pretend to work,
# in ms, so queue mechanics can be exercised end to end.
STUB_WORK_DURATION_MS=250
