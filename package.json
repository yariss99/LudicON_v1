{
  "name": "ludicon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ludicon/web",
    "dev:api": "turbo run dev --filter=@ludicon/api",
    "dev:stack": "turbo run dev --filter=@ludicon/web --filter=@ludicon/api --filter=@ludicon/worker",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "npm run db:generate -w @ludicon/api",
    "db:migrate": "npm run db:migrate -w @ludicon/api",
    "db:studio": "npm run db:studio -w @ludicon/api",
    "docker:web": "docker compose --profile web up --build",
    "docker:api": "docker compose --profile api up --build",
    "docker:full": "docker compose --profile full up --build",
    "docker:down": "docker compose --profile full down -v"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "oxlint": "^1.71.0",
    "prettier": "^3.4.2",
    "turbo": "^2.10.8",
    "typescript": "~6.0.3"
  }
}
