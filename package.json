{
  "name": "ludicon-v1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/eos",
    "packages/event-bus",
    "packages/command-bus",
    "packages/engine-sdk",
    "packages/engines/knowledge",
    "packages/engines/memory",
    "packages/engines/context",
    "packages/engines/recommendation",
    "packages/engines/quality",
    "packages/engines/validation",
    "packages/engines/tools",
    "packages/engines/workflow",
    "packages/engines/prompt",
    "packages/ai-orchestrator",
    "packages/runtime-orchestrator",
    "packages/core-kernel",
    "packages/composition"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:packages": "npm run build -w @prima/contracts && npm run build -w @prima/event-bus && npm run build -w @prima/eos && npm run build -w @prima/command-bus && npm run build -w @prima/engine-sdk && npm run build -w @prima/engine-knowledge && npm run build -w @prima/engine-memory && npm run build -w @prima/engine-context && npm run build -w @prima/engine-recommendation && npm run build -w @prima/engine-quality && npm run build -w @prima/engine-validation && npm run build -w @prima/engine-tools && npm run build -w @prima/engine-workflow && npm run build -w @prima/engine-prompt && npm run build -w @prima/ai-orchestrator && npm run build -w @prima/runtime-orchestrator && npm run build -w @prima/core-kernel && npm run build -w @prima/composition",
    "test:eos": "npm run test -w @prima/eos",
    "test:event-bus": "npm run test -w @prima/event-bus",
    "test:command-bus": "npm run test -w @prima/command-bus",
    "test:engine-sdk": "npm run test -w @prima/engine-sdk",
    "test:contracts": "npm run test -w @prima/contracts",
    "test:knowledge": "npm run test -w @prima/engine-knowledge",
    "test:memory": "npm run test -w @prima/engine-memory",
    "test:context": "npm run test -w @prima/engine-context",
    "test:recommendation": "npm run test -w @prima/engine-recommendation",
    "test:quality": "npm run test -w @prima/engine-quality",
    "test:validation-engine": "npm run test -w @prima/engine-validation",
    "test:tools": "npm run test -w @prima/engine-tools",
    "test:workflow": "npm run test -w @prima/engine-workflow",
    "test:ai-orchestrator": "npm run test -w @prima/ai-orchestrator",
    "test:runtime": "npm run test -w @prima/runtime-orchestrator",
    "test:core-kernel": "npm run test -w @prima/core-kernel",
    "test:prompt": "npm run test -w @prima/engine-prompt",
    "test:composition": "npm run test -w @prima/composition",
    "test:packages": "npm run test:contracts && npm run test:event-bus && npm run test:eos && npm run test:command-bus && npm run test:engine-sdk && npm run test:knowledge && npm run test:memory && npm run test:context && npm run test:recommendation && npm run test:quality && npm run test:validation-engine && npm run test:tools && npm run test:workflow && npm run test:prompt && npm run test:ai-orchestrator && npm run test:runtime && npm run test:core-kernel && npm run test:composition",
    "test:decision": "tsx --test src/engines/decision/tests/decisionEngine.acceptance.test.ts",
    "test:reasoning": "tsx --test src/engines/reasoning/tests/reasoningPipeline.acceptance.test.ts",
    "test:ai002": "tsx --test src/features/create-learning-experience/decision-engine/tests/*.test.ts",
    "test:validation": "tsx --test src/engines/validation/tests/pedagogicalValidation.acceptance.test.ts",
    "test:inference": "tsx --test src/engines/inference/tests/*.test.ts",
    "test:pie": "tsx --test src/engines/pie/tests/pieEngine.acceptance.test.ts",
    "test:upe": "tsx --test src/features/universal-editor/tests/upe.acceptance.test.ts",
    "test:pde": "tsx --test src/engines/pde/tests/pde.acceptance.test.ts",
    "test:rpti": "tsx --test src/engines/rpti/tests/rpti.acceptance.test.ts",
    "test:khpm": "tsx --test src/engines/khpm/tests/khpm.acceptance.test.ts",
    "test:sli": "tsx --test src/engines/sli/tests/sli.acceptance.test.ts",
    "test:blueprint-review": "tsx --test src/features/blueprint-review/tests/blueprintReview.acceptance.test.ts",
    "test:generation": "tsx --test src/features/generation-workspace/tests/generationWorkspace.acceptance.test.ts",
    "test:asset-studio": "tsx --test src/features/asset-studio/tests/assetStudio.acceptance.test.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
